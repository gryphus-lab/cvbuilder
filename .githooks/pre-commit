#!/usr/bin/env sh
set -e

# Get staged Python files
staged_python_files=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.py$' || true)

if [ -z "$staged_python_files" ]; then
    exit 0
fi

echo "pre-commit: formatting and fixing staged Python files with Ruff"

# Run ruff format and ruff check (fixing issues and ignoring E741)
echo "$staged_python_files" | xargs ruff format
echo "$staged_python_files" | xargs ruff check --fix --ignore E741

# Re-stage the modified files
echo "$staged_python_files" | xargs git add
