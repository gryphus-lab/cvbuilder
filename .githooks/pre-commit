#!/usr/bin/env sh
set -e

# Get staged Python files (NUL-delimited to handle spaces/special chars)
staged_python_files=$(git diff -z --cached --name-only --diff-filter=ACMR | grep -z '\.py$' || true)

if [ -z "$staged_python_files" ]; then
    exit 0
fi

echo "pre-commit: formatting and fixing staged Python files with Ruff"

# Run ruff format and ruff check (fixing issues)
printf '%s' "$staged_python_files" | xargs -0 ruff check --fix
printf '%s' "$staged_python_files" | xargs -0 ruff format

# Re-stage the modified files
printf '%s' "$staged_python_files" | xargs -0 git add