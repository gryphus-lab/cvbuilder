#!/usr/bin/env sh
set -e

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$staged_files" ]; then
  exit 0
fi

echo "pre-commit: formatting staged Python files only"
echo "$staged_files" | while IFS= read -r file; do
  case "$file" in
    *.py) black --fast -- "$file" ;;
  esac
done

echo "$staged_files" | while IFS= read -r file; do
  if [ -n "$file" ] && [ -e "$file" ]; then
    git add -- "$file"
  fi
done
